# Copy to .env (repo root or server/) and adjust. All values are optional.

# --- server ---
PORT=8787
NODE_ENV=development
# Postgres connection string. Leave empty to use the embedded SQLite file in DATA_DIR.
DATABASE_URL=
DATA_DIR=

# --- secrets (generated automatically on first run if unset) ---
# Session signing key
JWT_SECRET=
# 32-byte hex key used to encrypt student API keys at rest
VROQN_MASTER_KEY=

# --- optional access gate for self-hosted deployments ---
API_ACCESS_TOKEN=

# --- rate limits ---
# Failed attempts only: a successful sign-in or sign-up is refunded, so a whole school computer lab
# behind one NAT address does not lock itself out. Raise this if a shared network reports 429s.
# AUTH_RATE_MAX=60
# AUTH_RATE_WINDOW_MS=600000

# --- AI behaviour ---
AI_MAX_ATTEMPTS=8
AI_ATTEMPT_TIMEOUT_MS=45000
AI_COOLDOWN_RATE_LIMIT_MS=60000
AI_COOLDOWN_SERVER_ERROR_MS=20000
AI_COOLDOWN_AUTH_MS=21600000
AI_BETWEEN_ATTEMPTS_MS=250
# Offline sample engine. `off` guarantees no sample content is ever served, regardless of per-user
# settings. In production it defaults to OFF (sample answers must never look like model output);
# `on` is refused in production by the startup configuration check.
DEMO_MODE=on

# --- model overrides (no code changes needed to move to newer models) ---
# VROQN_MODEL_GEMINI_BALANCED=gemini-2.5-flash
# VROQN_MODEL_GEMINI_FAST=gemini-2.5-flash-lite
# VROQN_MODEL_GEMINI_DEEP=gemini-2.5-pro
# VROQN_MODEL_GROQ_BALANCED=llama-3.3-70b-versatile
# VROQN_MODEL_GROQ_VISION=meta-llama/llama-4-scout-17b-16e-instruct
# VROQN_MODEL_OPENROUTER_BALANCED=google/gemini-2.5-flash

# --- Arena (competitive exams) ---
# Comma-separated allowlist. Accounts on this list see /arena/admin and may author competitions.
# Leave empty for a student-only deployment; nobody can self-promote to admin.
ARENA_ADMIN_EMAILS=
# Allows `npm run seed:arena` to write demo competitions when NODE_ENV=production. Off by default.
# ARENA_SEED_DEMO=1
#
# --- Arena marking + paper approval ---
# Numerical answers are marked correct when they fall inside this tolerance, so a value typed as
# 9.81 instead of 9.8 is not marked wrong. Percent of the expected value (default 1%), with a small
# absolute tolerance used only when the expected value is exactly 0.
# A competition's own blueprint may override the percentage per paper.
ARENA_NUMERIC_TOLERANCE_PCT=1
ARENA_NUMERIC_TOLERANCE_ABS=1e-9
# Share of a paper's questions that must be approved before the competition can start (0.5–1).
# 1 = every question (recommended for a graded competition).
ARENA_REQUIRED_APPROVAL_RATIO=1

# --- Code Lab ---
CODE_RUN=on
CODE_TIMEOUT_MS=6000
CODE_MAX_OUTPUT_BYTES=40000

# --- embedding (optional) ---
# Only used when NODE_ENV=production. Allows specific origins to iframe the app (a school portal);
# omitted means cross-origin framing is refused. Example:
# FRAME_ANCESTORS='self' https://lms.school.edu

# --- database (production) ---
# Postgres is the production target. In production the server refuses to start without DATABASE_URL
# unless ALLOW_SQLITE_IN_PROD=1 (dev/demo only — SQLite cannot serve multiple instances safely).
# DATABASE_URL=postgres://user:pass@host:5432/vroqn
# ALLOW_SQLITE_IN_PROD=1
# `npm run seed --workspace server` writes demo accounts; in production it refuses to run unless
# SEED_ALLOW_PROD=1 and an explicit SEED_PASSWORD are set. Never ship the demo password.
# SEED_ALLOW_PROD=1
# SEED_PASSWORD=

# --- uploads ---
MAX_UPLOAD_MB=8
JSON_LIMIT=6mb
